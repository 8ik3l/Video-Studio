{
  "expo": {
    "name": "Video Studio",
    "slug": "video-studio",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "videostudio",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "com.videostudio.editor",
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "bundleIdentifier": "com.videostudio.editor",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Video Studio يحتاج الوصول إلى الصور والفيديوهات لاختيار الوسائط."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c9ad1eef-3589-4ffc-ad51-ce9f594857bd"
      }
    }
  }
}